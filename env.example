# Office Spaces settings.
# Locally: copy to .env. With DEV_LOGIN=1 and no DATABASE_URL you get an embedded
# database and a one-click dev sign-in, so the only thing you need is SESSION_SECRET.
# In production (Railway): set these as Variables on the `app` service.

# ── Required ────────────────────────────────────────────────────────────────
# NODE_ENV=production                               # set on Railway (the Dockerfile sets it); not locally
PUBLIC_BASE_URL=https://your-app.up.railway.app      # no trailing slash
SESSION_SECRET=                                      # openssl rand -hex 32
# DATABASE_URL=${{Postgres.DATABASE_URL}}             # set on Railway (its Postgres); leave unset locally

# Google sign-in: an OAuth client (scopes openid/email/profile only).
# Redirect URI: ${PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Only Google accounts on these domains can sign in (comma-separated).
ALLOWED_EMAIL_DOMAINS=yourcompany.com
# These become admins on first sign-in. Admins can promote others in the app.
ADMIN_EMAILS=you@yourcompany.com

# Media server (the `livekit` service). Same key/secret as on that service.
LIVEKIT_URL=wss://your-livekit.up.railway.app
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# One-click dev sign-in with made-up users. Local only, never in production.
# DEV_LOGIN=1

# Lets your own bot read bug/idea reports from GET /api/agent/feedback (32+ characters).
FEEDBACK_AGENT_KEY=

# Time tracking: who can see and manage everyone's time (defaults to ADMIN_EMAILS).
PAYROLL_ADMIN_EMAILS=
# Who can hand out points (defaults to ADMIN_EMAILS).
POINT_GIVERS=

# "Transcribe this room": the Whisper service in transcriber/, plus Claude for the notes.
TRANSCRIBER_URL=
TRANSCRIBER_KEY=                                     # openssl rand -hex 32, same on both services
ANTHROPIC_API_KEY=

# Slack: profile photos, "Message on Slack", DMs. Bot token with
# users:read, users:read.email, chat:write, im:write (deploy/slack-app-manifest.json).
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# Calendar + Meet + Drive (optional "Start meeting" and Drive filing). A second OAuth
# client with those scopes; falls back to the sign-in client.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
DRIVE_RECORDINGS_FOLDER_ID=
DRIVE_BACKUP_FOLDER_ID=                              # nightly database export (private folder)
# Fathom: one whsec_ per person's webhook → ${PUBLIC_BASE_URL}/webhooks/fathom, comma-separated.
FATHOM_WEBHOOK_SECRETS=

# Wall screen ("jumbotron" furniture): each feed is off until its settings are here.
JUMBOTRON_SLACK_TOKEN=
JUMBOTRON_SLACK_CHANNEL=                             # channel id: posts here show as new clients
WINS_CHANNEL=wins
NOTION_TOKEN=
NOTION_ROCKS_DATA_SOURCE=                            # Notion data source id for quarterly priorities
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=                                     # your Google Business listing, for reviews
JUMBOTRON_PUSH_KEY=

# Minutes of no keyboard/mouse before someone is marked Away.
IDLE_MINUTES=10
