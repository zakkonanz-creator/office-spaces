{
  "name": "office-spaces",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A self-hosted virtual office: walk up to someone to talk. Proximity audio/video on LiveKit, rooms with doors, guests, transcription and time tracking.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n lk,api,web -c gray,blue,green \"npm:dev:livekit\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:livekit": "livekit-server --dev --bind 127.0.0.1",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/jumbotron.test.ts server/unit.test.ts server/onboarding.test.ts server/fathom.test.ts server/streaks.test.ts server/points.test.ts server/feedback.test.ts server/wins.test.ts server/time/*.test.ts shared/*.test.ts",
    "e2e": "tsx scripts/e2e.ts && tsx scripts/e2e-ui.ts && tsx scripts/e2e-preassign.ts && tsx scripts/e2e-design.ts",
    "shots": "tsx scripts/shots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.5",
    "livekit-server-sdk": "^2.19.1",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@livekit/track-processors": "^0.8.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "livekit-client": "^2.22.3",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  },
  "license": "MIT"
}
